# ───────────────────────────────────────────────────────────────────────────
# Astralis — environment variables.
# Copy to .env.local for local dev; set the same in Vercel → Project → Settings →
# Environment Variables for production. .env* is gitignored — never commit secrets.
# Code degrades gracefully when a var is missing (clear errors, no crashes).
# ───────────────────────────────────────────────────────────────────────────

# Stripe — server-side only. Hosted Checkout redirects via the session URL, so no
# publishable key / Stripe.js runs in the browser.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx                 # from the webhook endpoint / `stripe listen`

# Resend — transactional email (verification code + order confirmation with the
# certificate PDFs attached). RESEND_FROM must be a verified sender/domain.
RESEND_API_KEY=re_xxx
RESEND_FROM=Astralis Registry <noreply@astralisregistry.com>

# Internal "new order" notifications (buyer name, address, items + a digital vs
# print-&-ship banner so you know what to fulfil) are emailed here. Sent for
# EVERY order — it is how a Premium/Ultimate order awaiting postage gets
# noticed. ORDER_NOTIFY_EMAIL is the old name, still honoured as a fallback.
OWNER_EMAIL=help.astralis@gmail.com

# Which packages attach the certificate PDF to that owner copy, so it can be
# forwarded straight from the inbox when a customer contacts support. This
# controls the ATTACHMENT only, never whether the email is sent. Comma
# separated; `none` disables attachments.
OWNER_COPY_PACKAGES=standard,premium,ultimate

# Public origin — builds success/cancel URLs and the absolute certificate download
# + order-portal links that go into the confirmation email.
NEXT_PUBLIC_SITE_URL=https://astralisregistry.com

# Google Analytics 4 — optional, privacy-gated behind the cookie-consent banner.
# Format G-XXXXXXXXXX. NEXT_PUBLIC_ so it is readable in the browser; a GA4
# Measurement ID is NOT secret (it ships to every visitor). When unset, analytics
# simply never loads — no banner cookies, no gtag.js, no errors. The static
# marketing page reads it at runtime via /ga-config.js; the React pages inline it
# at build time. GA4 fires only after the visitor clicks "Accept".
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

# Password for the private certificate generator at /admin/certificate, where a
# certificate can be rendered and emailed by hand with no Stripe charge. Must be
# at least 16 characters or the page stays closed (401). Use a long random
# string (e.g. `openssl rand -hex 32`). Separate from ADMIN_API_TOKEN below:
# this one is typed into a browser, that one is a bearer token for curl.
ADMIN_SECRET=

# Manual fulfilment replay — POST /api/admin/fulfill, used to deliver an order
# that was charged but never fulfilled (see docs/RUNBOOK-FULFILMENT.md). The
# route 404s while this is unset or shorter than 24 characters, so it is inert
# by default. Use a long random string (e.g. `openssl rand -hex 32`).
ADMIN_API_TOKEN=

# HMAC secret for the tokenised (no-login) order/certificate links. Use a long
# random string (e.g. `openssl rand -hex 32`). Falls back to a dev secret if unset.
ORDER_TOKEN_SECRET=change-me-to-a-long-random-string

# Durable storage (optional). When both are set, orders + certificates persist in
# Vercel KV / Upstash Redis across serverless instances; otherwise an in-memory
# fallback is used (fine for local dev + warm instances).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Fulfilment tuning (all optional; the defaults are deliberate) ──────────
# Headless Chromium is the only step that can outlive the function's
# maxDuration, and when it did, the function was killed before the confirmation
# email and the customer received nothing. Rendering is therefore bounded, and
# these budgets must stay comfortably inside the routes' maxDuration (60s).
# Anything that does not render still ships: every certificate gets an id, a
# portal entry and a download link that renders on demand.
CERT_RENDER_BUDGET_MS=34000      # total render time per fulfilment
CERT_RENDER_TIMEOUT_MS=22000     # ceiling for a single certificate
CERT_DOWNLOAD_RENDER_TIMEOUT_MS=45000  # on-demand re-render in the download route
FULFIL_LOCK_WAIT_MS=12000        # wait for another instance before reporting failure
MAX_ATTACH_BYTES=12000000        # cap on PDF bytes attached to one email
# Vercel KV / Upstash reject values over a per-plan ceiling (1 MB on entry
# tiers) and a base64 certificate PDF is ~1.1 MB, so blob caching is skipped
# above this. Raise it if the store's plan allows larger values.
KV_MAX_VALUE_BYTES=900000

# Certificate PDF rendering (headless Chromium).
#  • Local dev: point at your system Chrome/Chromium executable.
#  • Vercel/serverless: leave UNSET — @sparticuz/chromium is used automatically.
# PUPPETEER_EXECUTABLE_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe
PUPPETEER_EXECUTABLE_PATH=
